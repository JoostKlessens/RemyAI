# Supabase project credentials.
# EXPO_PUBLIC_* variables are inlined into the client bundle at build time —
# never put a service_role key or any other secret behind this prefix.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Supabase Edge Functions). NOT prefixed with EXPO_PUBLIC_
# so it is never bundled into the client. Used by the scheduled 16:00
# decision function and by expo-server-sdk push delivery.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Expo push notifications (see docs/ARCHITECTURE.md for the push flow).
EXPO_ACCESS_TOKEN=your-expo-access-token

# Recipe extraction LLM (Supabase Edge Function parse-recipe).
# Set on the function runtime, NOT read from this file:
#   supabase secrets set GEMINI_API_KEY=your-gemini-key
# Optional: pin an exact model snapshot instead of the floating default
# (gemini-3.6-flash) with GEMINI_MODEL.
GEMINI_API_KEY=your-gemini-api-key
